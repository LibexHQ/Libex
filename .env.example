# Database — required
DB_NAME=libex
DB_USER=libex
DB_PASSWORD=your_secure_password

# DATABASE_URL is auto-constructed by docker-compose from DB_NAME, DB_USER, and DB_PASSWORD.
# Only set this manually if running outside of Docker.
# DATABASE_URL=postgresql+asyncpg://libex:your_secure_password@localhost:5432/libex

# Application
DEBUG=false
HOST=0.0.0.0
PORT=3333
DEFAULT_REGION=us

# Cache
CACHE_ENABLED=true
CACHE_TTL=86400

# Logging
LOG_RETENTION_DAYS=7  # 0 = infinite, N = keep N days of rotated logs
LOG_LEVEL=INFO        # DEBUG, INFO, WARNING, or ERROR

# Axiom (optional — leave blank to use stdout only)
AXIOM_TOKEN=
AXIOM_DATASET=libex

# Seeder (optional — disabled by default)
SEEDER_ENABLED=false
SEEDER_INTERVAL_HOURS=24
SEEDER_REQUEST_DELAY=1.0
SEEDER_REGIONS=us
SEEDER_NEW_RELEASES_INTERVAL_HOURS=24    # New-releases worker runs on its own interval
SEEDER_REFRESH_ENABLED=false             # Re-fetch upcoming pre-orders as their release date nears

# Proxy (optional — route Audible requests through a proxy)
AUDIBLE_PROXY_URL=

# Internal seed endpoint (optional - disabled by default)
# The base64 PBKDF2 *hash*, not the bearer token itself. Empty disables
# /internal/seed/narrators outright. Generate with:
#   python -m app.api.routes.internal.router
SEED_SECRET=

# Migration notice (optional - off by default)
# Emits RFC 9745 Deprecation / RFC 8594 Sunset / Link headers announcing a move
# to another host. Leave disabled unless YOU are moving YOUR instance - these
# name a hostname and dates, and a populated set tells your callers to migrate
# somewhere that is not yours. Enabling needs NEW_HOST, ANNOUNCED and SUNSET
# together; INFO_URL is optional.
#
# Keep any note about these on its own line, never after the "=". Compose strips
# a trailing comment only when the line already has a value: on an empty one it
# keeps the comment AS the value, so "MIGRATION_ANNOUNCED=  # ISO date" sets the
# date to the words "# ISO date" and the notice silently never renders.
# ANNOUNCED and SUNSET are ISO dates, e.g. 2026-08-06 and 2026-11-04.
MIGRATION_NOTICE_ENABLED=false
MIGRATION_NEW_HOST=
MIGRATION_ANNOUNCED=
MIGRATION_SUNSET=
MIGRATION_INFO_URL=

# Deployment shape (optional)
# Host the container's own healthcheck curls. localhost checks the process from
# inside the container. Set this to the Docker host's address to send the check
# out and back through the published port, which also proves the port binding
# works. Leave it at localhost if you change PORT.
HEALTHCHECK_HOST=localhost
# Host path bound to /app/logs. A relative path resolves next to docker-compose.yml.
LOGS_PATH=./logs
