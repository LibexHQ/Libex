# bash completion for libex-core, generated from the command definitions, do not edit by hand
_libex_core() {
    local cur cmd ci i word
    local -a candidates
    cur="${COMP_WORDS[COMP_CWORD]}"
    cmd=""
    ci=0
    for ((i = 1; i < COMP_CWORD; i++)); do
        case "${COMP_WORDS[i]}" in
            -*) ;;
            *) cmd="${COMP_WORDS[i]}"; ci=$i; break ;;
        esac
    done
    case "$cmd" in
        "") candidates=(-h --help --version -q --quiet -v --verbose book series author search quick-search abs narrator releases completion config) ;;
        book)
            if (( COMP_CWORD == ci + 1 )); then
                candidates=(get bulk chapters)
            else
                case "${COMP_WORDS[ci + 1]}" in
                    get)
                        case "${COMP_WORDS[COMP_CWORD - 1]}" in
                            --region) candidates=(us uk ca au de fr it es jp in br) ;;
                            *) candidates=(-h --help --region) ;;
                        esac
                        ;;
                    bulk)
                        case "${COMP_WORDS[COMP_CWORD - 1]}" in
                            --region) candidates=(us uk ca au de fr it es jp in br) ;;
                            --explicit) candidates=(true false) ;;
                            --whisper-sync) candidates=(true false) ;;
                            --has-pdf) candidates=(true false) ;;
                            --is-vvab) candidates=(true false) ;;
                            --sort) candidates=(title releaseDate rating lengthMinutes language publisher updatedAt) ;;
                            --order) candidates=(asc desc) ;;
                            *) candidates=(-h --help --file --region --language --book-format --explicit --whisper-sync --has-pdf --is-vvab --plan-name --rating-better-than --rating-worse-than --longer-than --shorter-than --genre --sort --order) ;;
                        esac
                        ;;
                    chapters)
                        case "${COMP_WORDS[COMP_CWORD - 1]}" in
                            --region) candidates=(us uk ca au de fr it es jp in br) ;;
                            *) candidates=(-h --help --region) ;;
                        esac
                        ;;
                    *) candidates=() ;;
                esac
            fi
            ;;
        series)
            if (( COMP_CWORD == ci + 1 )); then
                candidates=(get books search)
            else
                case "${COMP_WORDS[ci + 1]}" in
                    get)
                        case "${COMP_WORDS[COMP_CWORD - 1]}" in
                            --region) candidates=(us uk ca au de fr it es jp in br) ;;
                            *) candidates=(-h --help --region) ;;
                        esac
                        ;;
                    books)
                        case "${COMP_WORDS[COMP_CWORD - 1]}" in
                            --region) candidates=(us uk ca au de fr it es jp in br) ;;
                            --explicit) candidates=(true false) ;;
                            --whisper-sync) candidates=(true false) ;;
                            --has-pdf) candidates=(true false) ;;
                            --is-vvab) candidates=(true false) ;;
                            --sort) candidates=(title releaseDate rating lengthMinutes language publisher updatedAt) ;;
                            --order) candidates=(asc desc) ;;
                            *) candidates=(-h --help --region --language --book-format --explicit --whisper-sync --has-pdf --is-vvab --plan-name --rating-better-than --rating-worse-than --longer-than --shorter-than --genre --sort --order) ;;
                        esac
                        ;;
                    search)
                        case "${COMP_WORDS[COMP_CWORD - 1]}" in
                            --region) candidates=(us uk ca au de fr it es jp in br) ;;
                            *) candidates=(-h --help --region) ;;
                        esac
                        ;;
                    *) candidates=() ;;
                esac
            fi
            ;;
        author)
            if (( COMP_CWORD == ci + 1 )); then
                candidates=(get search books books-by-name)
            else
                case "${COMP_WORDS[ci + 1]}" in
                    get)
                        case "${COMP_WORDS[COMP_CWORD - 1]}" in
                            --region) candidates=(us uk ca au de fr it es jp in br) ;;
                            *) candidates=(-h --help --region) ;;
                        esac
                        ;;
                    search)
                        case "${COMP_WORDS[COMP_CWORD - 1]}" in
                            --region) candidates=(us uk ca au de fr it es jp in br) ;;
                            *) candidates=(-h --help --region) ;;
                        esac
                        ;;
                    books)
                        case "${COMP_WORDS[COMP_CWORD - 1]}" in
                            --region) candidates=(us uk ca au de fr it es jp in br) ;;
                            --explicit) candidates=(true false) ;;
                            --whisper-sync) candidates=(true false) ;;
                            --has-pdf) candidates=(true false) ;;
                            --is-vvab) candidates=(true false) ;;
                            --sort) candidates=(title releaseDate rating lengthMinutes language publisher updatedAt) ;;
                            --order) candidates=(asc desc) ;;
                            *) candidates=(-h --help --region --language --book-format --explicit --whisper-sync --has-pdf --is-vvab --plan-name --rating-better-than --rating-worse-than --longer-than --shorter-than --genre --sort --order) ;;
                        esac
                        ;;
                    books-by-name)
                        case "${COMP_WORDS[COMP_CWORD - 1]}" in
                            --region) candidates=(us uk ca au de fr it es jp in br) ;;
                            --explicit) candidates=(true false) ;;
                            --whisper-sync) candidates=(true false) ;;
                            --has-pdf) candidates=(true false) ;;
                            --is-vvab) candidates=(true false) ;;
                            --sort) candidates=(title releaseDate rating lengthMinutes language publisher updatedAt) ;;
                            --order) candidates=(asc desc) ;;
                            *) candidates=(-h --help --region --language --book-format --explicit --whisper-sync --has-pdf --is-vvab --plan-name --rating-better-than --rating-worse-than --longer-than --shorter-than --genre --sort --order) ;;
                        esac
                        ;;
                    *) candidates=() ;;
                esac
            fi
            ;;
        search)
            case "${COMP_WORDS[COMP_CWORD - 1]}" in
                --region) candidates=(us uk ca au de fr it es jp in br) ;;
                *) candidates=(-h --help --title --author --narrator --publisher --keywords --query --sort-by --limit --page --region) ;;
            esac
            ;;
        quick-search)
            case "${COMP_WORDS[COMP_CWORD - 1]}" in
                --region) candidates=(us uk ca au de fr it es jp in br) ;;
                *) candidates=(-h --help --region) ;;
            esac
            ;;
        abs)
            if (( COMP_CWORD == ci + 1 )); then
                candidates=(search quick-search)
            else
                case "${COMP_WORDS[ci + 1]}" in
                    search)
                        case "${COMP_WORDS[COMP_CWORD - 1]}" in
                            --region) candidates=(us uk ca au de fr it es jp in br) ;;
                            *) candidates=(-h --help --title --query --author --keywords --region) ;;
                        esac
                        ;;
                    quick-search)
                        case "${COMP_WORDS[COMP_CWORD - 1]}" in
                            --region) candidates=(us uk ca au de fr it es jp in br) ;;
                            *) candidates=(-h --help --keywords --query --title --region) ;;
                        esac
                        ;;
                    *) candidates=() ;;
                esac
            fi
            ;;
        narrator)
            if (( COMP_CWORD == ci + 1 )); then
                candidates=(books)
            else
                case "${COMP_WORDS[ci + 1]}" in
                    books)
                        case "${COMP_WORDS[COMP_CWORD - 1]}" in
                            --region) candidates=(us uk ca au de fr it es jp in br) ;;
                            *) candidates=(-h --help --limit --page --region) ;;
                        esac
                        ;;
                    *) candidates=() ;;
                esac
            fi
            ;;
        releases)
            if (( COMP_CWORD == ci + 1 )); then
                candidates=(new coming-soon categories)
            else
                case "${COMP_WORDS[ci + 1]}" in
                    new)
                        case "${COMP_WORDS[COMP_CWORD - 1]}" in
                            --days) candidates=(30 60 90 120 240 365) ;;
                            --region) candidates=(us uk ca au de fr it es jp in br) ;;
                            --explicit) candidates=(true false) ;;
                            --whisper-sync) candidates=(true false) ;;
                            --has-pdf) candidates=(true false) ;;
                            --is-vvab) candidates=(true false) ;;
                            --sort) candidates=(title releaseDate rating lengthMinutes language publisher updatedAt) ;;
                            --order) candidates=(asc desc) ;;
                            *) candidates=(-h --help --days --category --region --language --book-format --explicit --whisper-sync --has-pdf --is-vvab --plan-name --rating-better-than --rating-worse-than --longer-than --shorter-than --genre --sort --order) ;;
                        esac
                        ;;
                    coming-soon)
                        case "${COMP_WORDS[COMP_CWORD - 1]}" in
                            --days) candidates=(30 60 90 120 240 365) ;;
                            --region) candidates=(us uk ca au de fr it es jp in br) ;;
                            --explicit) candidates=(true false) ;;
                            --whisper-sync) candidates=(true false) ;;
                            --has-pdf) candidates=(true false) ;;
                            --is-vvab) candidates=(true false) ;;
                            --sort) candidates=(title releaseDate rating lengthMinutes language publisher updatedAt) ;;
                            --order) candidates=(asc desc) ;;
                            *) candidates=(-h --help --days --category --region --language --book-format --explicit --whisper-sync --has-pdf --is-vvab --plan-name --rating-better-than --rating-worse-than --longer-than --shorter-than --genre --sort --order) ;;
                        esac
                        ;;
                    categories)
                        case "${COMP_WORDS[COMP_CWORD - 1]}" in
                            --region) candidates=(us uk ca au de fr it es jp in br) ;;
                            *) candidates=(-h --help --flat --depth --region) ;;
                        esac
                        ;;
                    *) candidates=() ;;
                esac
            fi
            ;;
        completion)
            if (( COMP_CWORD == ci + 1 )); then
                candidates=(-h --help bash zsh fish)
            else
                candidates=(-h --help)
            fi
            ;;
        config) candidates=(-h --help) ;;
        *) candidates=() ;;
    esac
    COMPREPLY=()
    for word in "${candidates[@]}"; do
        if [[ $word == "$cur"* ]]; then
            COMPREPLY+=("$word")
        fi
    done
}
complete -F _libex_core libex-core
