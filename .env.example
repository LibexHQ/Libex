# Database — required
DB_NAME=libex
DB_USER=libex
DB_PASSWORD=your_secure_password

# DATABASE_URL is auto-constructed by docker-compose from DB_NAME, DB_USER, and DB_PASSWORD.
# Only set this manually if running outside of Docker.
# DATABASE_URL=postgresql+asyncpg://libex:your_secure_password@localhost:5432/libex

# Application
DEBUG=false
HOST=0.0.0.0
PORT=3333
DEFAULT_REGION=us

# Cache
CACHE_ENABLED=true
CACHE_TTL=86400

# Logging
LOG_RETENTION_DAYS=7  # 0 = infinite, N = keep N days of rotated logs
LOG_LEVEL=INFO        # DEBUG, INFO, WARNING, or ERROR

# Axiom (optional — leave blank to use stdout only)
AXIOM_TOKEN=
AXIOM_DATASET=libex

# Seeder (optional — its own stack, not part of the API)
# The seeder is not in docker-compose.yml at all. It is docker-compose.seeder.yml,
# a separate stack deployed on its own, the way the chapter backfill and the
# corpus refresh already are. Deploying that stack is what enables seeding —
# there is no SEEDER_ENABLED any more, and a plain `docker compose up -d` here
# never starts it.
#
# The names below are documented here because this file is where every
# operator-settable name is listed, but they are read by the seeder container
# and nothing in the API stack passes them on. Set them in the seeder stack's
# own environment. It reaches this stack's Postgres over the libex-db Docker
# network, which this stack creates — so deploy this one first. DB_PASSWORD and
# SEEDER_PROXY_URL are the only two it requires with no default, and DB_PASSWORD
# must be the same value as above.
SEEDER_INTERVAL_HOURS=24
SEEDER_REQUEST_DELAY=1.0
SEEDER_REGIONS=us
SEEDER_NEW_RELEASES_INTERVAL_HOURS=24    # New-releases worker runs on its own interval
SEEDER_REFRESH_ENABLED=false             # Re-fetch upcoming pre-orders as their release date nears

# The exit the seeder's Audible requests leave by, and required to run it: the
# seeder refuses to start unless the hostname here contains "seeder", rather
# than sending an unattended catalogue walk out through the address your API
# answers on. Deliberately a different name from AUDIBLE_PROXY_URL below, so
# the API's proxy can never become the seeder's by a copied line. Set it in the
# seeder stack's environment, not here — that stack requires it and refuses to
# deploy without it.
SEEDER_PROXY_URL=
# Memory ceiling for the seeder container. Raise it if the container is
# OOM-killed and restarted in a loop.
SEEDER_MEM_LIMIT=1g

# Proxy (optional — route the API's outbound Audible requests through a proxy)
# The seeder stack has its own, SEEDER_PROXY_URL above.
AUDIBLE_PROXY_URL=

# Internal seed endpoint (optional - disabled by default)
# The base64 PBKDF2 *hash*, not the bearer token itself. Empty disables
# /internal/seed/narrators outright. Generate with:
#   python -m app.api.routes.internal.router
SEED_SECRET=

# Backup (optional — the capability ships in every deployment, idle)
# The libex-backup service is always in docker-compose.yml, with no profile.
# What turns backups on is configuration, not deployment: leave the FTPS
# settings below blank and the container comes up, says it has no
# destination, and does nothing. Fill them in and it starts running to the
# schedule here. There is no BACKUP_ENABLED.
#
# When. TIME is HH:MM local to TIMEZONE, an IANA name (Europe/London,
# America/New_York) — not an offset, so daylight saving is handled for you.
# DAY_OF_WEEK matters only when PERIOD=weekly, DAY_OF_MONTH only when
# PERIOD=monthly; the other one is ignored rather than rejected.
BACKUP_TIMEZONE=UTC
BACKUP_PERIOD=daily          # daily, weekly or monthly
BACKUP_TIME=03:00
BACKUP_DAY_OF_WEEK=sunday
BACKUP_DAY_OF_MONTH=1

# What to keep. Three tiers, all applied: the most recent N artefacts, PLUS
# the newest one that is at least AGED_DAYS old, PLUS the oldest one that is
# not yet AGED_DAYS old. The second tier is the one that matters when damage
# is noticed late — six nightly copies of a database that went wrong a week
# ago are six copies of the same wrong database. The third is what makes the
# second possible: without it the recent tier deletes every candidate long
# before it is old enough, so the aged copy is never created at all. Eight
# artefacts at the defaults below. Set AGED_DAYS to 0 to keep only the recent
# tier.
BACKUP_RETENTION_RECENT=6
BACKUP_RETENTION_AGED_DAYS=30

# How long each half is allowed to take, in seconds. A clean dump of a 2.38 GB
# database measured 8m39s, so 3600 is roughly seven times a healthy run —
# generous on purpose, for a busy host or a database that has grown. The dump
# timeout is not free to raise arbitrarily: pg_dump holds one snapshot open
# for its whole run and Postgres reclaims nothing newer until it finishes. If
# you raise it past 3600, raise stop_grace_period in docker-compose.yml with
# it; the comment on that line explains why they are tied.
BACKUP_DUMP_TIMEOUT_SECONDS=3600
BACKUP_DESTINATION_TIMEOUT_SECONDS=3600

# FTPS destination. Blank = no destination, which is the default and is a
# perfectly good deployment. A partial set is treated the same way: the
# destination is inactive and the container says which piece is missing,
# rather than attempting an upload it cannot secure.
#
# PORT 21 is explicit FTPS — the connection opens in the clear and is
# upgraded with AUTH TLS. It is NOT implicit FTPS on port 990, which starts
# the TLS handshake before the first command. The two get confused constantly
# and they are not interchangeable; if your NAS documentation says "FTPS
# (implicit)" on 990, this will not talk to it.
#
# PATH is the directory on the server that dumps are written into, and it is
# one of the required pieces rather than an optional one. Blank is not a way
# to say "no destination": with a host, a user and a password set, an empty
# PATH would leave the destination active and uploading into whatever
# directory the login lands in. Set it to . if that directory is the one you
# actually want.
BACKUP_FTPS_HOST=
BACKUP_FTPS_PORT=21
BACKUP_FTPS_USER=
BACKUP_FTPS_PASSWORD=
BACKUP_FTPS_PATH=

# The server's certificate, and in practice you need it: a NAS almost always
# presents a self-signed certificate, and there is deliberately no setting
# that turns verification off. A destination that cannot be verified does not
# run.
#
# Two settings because the file has to get into the container. CA_PATH is a
# directory on the host holding the certificate; it is mounted read-only at
# /etc/libex/ftps-ca. CA_BUNDLE is the path to the file inside the container,
# so it starts with that directory. Copy the certificate out of your NAS's
# admin interface, drop it in a directory, and set both:
#     BACKUP_FTPS_CA_PATH=./ftps-ca
#     BACKUP_FTPS_CA_BUNDLE=/etc/libex/ftps-ca/nas.crt
# Left at its default, CA_PATH is an empty Docker volume and nothing is
# mounted that matters.
#
# Worth knowing what this buys: trusting one certificate file means trusting
# that file and nothing else — the 100-odd public certificate authorities
# your system normally trusts are not consulted at all. That is stronger than
# ordinary web verification, not weaker. It is your box, and only your box.
BACKUP_FTPS_CA_PATH=libex-backup-ca
BACKUP_FTPS_CA_BUNDLE=

# Only if the certificate's name does not match the address you connect to —
# a NAS certificate issued for "nas.local" while you reach it at 192.168.1.20,
# which is the usual case. Set it to the name ON the certificate. Leave blank
# and the host above is what gets checked.
BACKUP_FTPS_SERVER_HOSTNAME=

# Where the dump is written on its way to the destination. Not the archive —
# a working area that holds one file between pg_dump finishing and the upload
# finishing, so it needs room for a whole dump and nothing more.
#
# The default is a Docker named volume, which just works: Docker creates it
# with the ownership the image gives the directory, so the unprivileged
# process inside can write to it with no setup from you. Change this only if
# you need the spool on a particular disk — the volume lives under
# /var/lib/docker, which on some hosts is a small root filesystem.
#
# If you do change it to a path (absolute, or ./relative to this file),
# Compose treats it as a bind mount and the ownership becomes yours to get
# right: Docker creates a missing directory as root, the container runs as
# uid 1000, and the first dump fails with a permission error. Create it
# yourself first:
#     mkdir -p /your/path && sudo chown 1000:1000 /your/path
# There is no matching container-side setting to change. The path inside the
# container is fixed, the same way the listening port is.
BACKUP_SPOOL_PATH=libex-backup-spool
# Memory ceiling for the backup container. It streams rather than buffering,
# so this is a guard and not a measurement — raise it if the container is
# OOM-killed, the same as SEEDER_MEM_LIMIT above.
BACKUP_MEM_LIMIT=512m

# Migration notice (optional - off by default)
# Emits RFC 9745 Deprecation / RFC 8594 Sunset / Link headers announcing a move
# to another host. Leave disabled unless YOU are moving YOUR instance - these
# name a hostname and dates, and a populated set tells your callers to migrate
# somewhere that is not yours. Enabling needs NEW_HOST, ANNOUNCED and SUNSET
# together; INFO_URL is optional.
#
# Keep any note about these on its own line, never after the "=". Compose strips
# a trailing comment only when the line already has a value: on an empty one it
# keeps the comment AS the value, so "MIGRATION_ANNOUNCED=  # ISO date" sets the
# date to the words "# ISO date" and the notice silently never renders.
# ANNOUNCED and SUNSET are ISO dates, e.g. 2026-08-06 and 2026-11-04.
MIGRATION_NOTICE_ENABLED=false
MIGRATION_NEW_HOST=
MIGRATION_ANNOUNCED=
MIGRATION_SUNSET=
MIGRATION_INFO_URL=

# Deployment shape (optional)
# Host the container's own healthcheck curls. localhost checks the process from
# inside the container. Set this to the Docker host's address to send the check
# out and back through the published port, which also proves the port binding
# works. Leave it at localhost if you change PORT.
HEALTHCHECK_HOST=localhost
# Host path bound to /app/logs. A relative path resolves next to docker-compose.yml.
# Both the API and the backup container mount this one path and append to the
# one libex.log in it — deliberately, so a backup failure is in the file you
# already read rather than in a second one you would have to know about. They
# are safe to share: writes are appends the kernel makes atomic, and the
# midnight rotation is taken by one process at a time behind a lock file. The
# retention above applies to that shared file, once, for both of them.
LOGS_PATH=./logs
# Size of /dev/shm inside the Postgres container, where Postgres allocates the
# shared memory each parallel query's workers hand results back through.
# Docker's own default is 64MB, small enough that a parallel scan over a large
# table fails the query outright with "No space left on device". tmpfs allocates
# on use, so this is a ceiling rather than RAM claimed at startup — but what it
# does claim is RAM, competing with the page cache. Lower it on a small host.
DB_SHM_SIZE=1gb
# Host address the Postgres port publishes on. 127.0.0.1 keeps it on the box:
# the seeder reaches the database over libex-db, not this port, so it is only
# for your own psql/DBeaver — direct or through an ssh tunnel. 0.0.0.0 opens it
# to your whole network with only the Postgres password in front.
DB_BIND=127.0.0.1
