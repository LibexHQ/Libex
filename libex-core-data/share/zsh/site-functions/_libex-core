#compdef libex-core
# zsh completion for libex-core, generated from the command definitions, do not edit by hand

_libex-core() {
    local curcontext="$curcontext" state line
    typeset -A opt_args

    _arguments -C \
        '(- *)'{-h,--help}'[show this help message and exit]' \
        '(- *)--version[show the version number and exit]' \
        {-q,--quiet}'[print only the final error line]' \
        {-v,--verbose}'[more detail on standard error (repeat as -vv for debug output with tracebacks)]' \
        '1: :->command' \
        '*:: :->args'

    case $state in
        command)
            local -a commands
            commands=(
                'completion:print a shell completion script'
                'config:show how requests would leave this machine'
            )
            _describe -t commands 'libex-core command' commands
            ;;
        args)
            case ${line[1]} in
                completion)
                    _arguments \
                        '(- *)'{-h,--help}'[show this help message and exit]' \
                        '1:shell:(bash zsh fish)'
                    ;;
                config)
                    _arguments \
                        '(- *)'{-h,--help}'[show this help message and exit]'
                    ;;
            esac
            ;;
    esac
}

_libex-core "$@"
